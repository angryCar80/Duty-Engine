    public static Rect GetAABB(Vector2 pos, BoxCollider col)
    {
        return new Rect(
            pos.X + col.OffsetX - col.Width / 2,
            pos.Y + col.OffsetY - col.Height,
            col.Width, col.Height
        );
    }
